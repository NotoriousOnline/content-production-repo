# ── Server logs (/logs UI) ─────────────────
# Strong password for the in-app logs viewer. Requires app_logs table — run supabase/migrations/004_app_logs.sql
LOGS_VIEWER_PASSWORD=


# ── WordPress / WAF (optional) ────────────
# If Cloudflare returns 403 + “Just a moment…” for /wp-json/ from Vercel, Node cannot solve the browser
# challenge — infra must allowlist the app (recommended: cookie that matches a Cloudflare rule).
# Set on Vercel (same value your Cloudflare rule expects). Example name/value from infra:
# WORDPRESS_WAF_BYPASS_COOKIE=cf_bypass=YOUR_HEX_SECRET
# Other options (if your rule uses them instead):
# WORDPRESS_WAF_BYPASS_QUERY=bypass_key=SHARED_SECRET
# WORDPRESS_WAF_BYPASS_HEADER_NAME=X-Publisher-Secret
# WORDPRESS_WAF_BYPASS_HEADER_VALUE=SHARED_SECRET
# WORDPRESS_REST_USER_AGENT_SUFFIX=YourPublisher/1.0
# Alternative (no WAF secret): point REST calls to an unproxied WP origin/API subdomain:
# WORDPRESS_REST_BASE_URL=https://origin.example.com
#
# Media upload host: if you see getaddrinfo ENOTFOUND for www., your apex may be the only DNS name
# that resolves from Vercel. Do not set WORDPRESS_REST_TRY_WWW_FALLBACK unless www exists in public DNS.
# WORDPRESS_REST_TRY_WWW_FALLBACK=true
#
# If Vercel cannot resolve the Site URL (ENOTFOUND) but the domain works in a browser, the app falls back
# to DNS-over-HTTPS (Cloudflare + Google). Disable only if outbound HTTPS to DoH is blocked:
# WORDPRESS_DNS_DOH_FALLBACK=false
#
# Timeouts for /wp-json/ (Undici default connect timeout is 10s — too short behind Cloudflare):
# WORDPRESS_REST_CONNECT_TIMEOUT_MS=60000
# WORDPRESS_REST_HEADERS_TIMEOUT_MS=120000
# WORDPRESS_REST_BODY_TIMEOUT_MS=300000
# WORDPRESS_REST_FETCH_RETRIES=3


# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for content-production wp_sites. Get from Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic (Claude AI) ─────────────────
ANTHROPIC_API_KEY=

# ── Ahrefs (optional: Content Production → Extract from title)
# This app calls the Ahrefs REST API (api.ahrefs.com), NOT MCP. Use a normal API key from:
# https://app.ahrefs.com/account/api-keys
# Cursor/ChatGPT "MCP" keys or OAuth tokens for Ahrefs MCP will NOT work here — create a separate API key.
# Uses API units from your paid plan.
AHREFS_API_KEY=
# Keywords Explorer country (ISO 3166-1 alpha-2), default us
AHREFS_KEYWORD_COUNTRY=us

# ── Article Title Discovery (Green.org daily news shortlist) ───────────────
OPENAI_API_KEY=
ARTICLE_SLACK_WEBHOOK_URL=
# Scans six fixed sources (ENN, Bloomberg Green, Reuters Environment, Carbon Brief,
# Canary Media, The Guardian Environment). Categories: Energy / Tech / Climate / Transportation.
# 24h freshness window from earliest break time. Returns a shortlist — you pick the final two.
#
# Optional: Inoreader (Pro + registered app) — merge newest items whose URLs match those six hosts.
# Register at https://www.inoreader.com/developers/register-app — OAuth refresh token (see OAuth docs).
# Put relevant blog feeds into one Inoreader folder, then set stream id to that folder:
#   user/-/label/Your Folder Name
# (exact folder name as shown in Inoreader; spaces ok.)
# INOREADER_CLIENT_ID=
# INOREADER_CLIENT_SECRET=
# INOREADER_REFRESH_TOKEN=
# INOREADER_APP_ID=
# INOREADER_APP_KEY=
# INOREADER_STREAM_ID=user/-/label/Your Folder Name
# Optional UI label for the tool (does not change API behavior):
# INOREADER_STREAM_LABEL=Green.org sources
# If Inoreader errors, fall back to the six built-in feeds (default true). Set false to fail closed.
# INOREADER_FALLBACK_TO_RSS=true

# ── Weed.com: Google Sheet article queue (optional; Weed tool loads rows from Sheets API)
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# WEED_ARTICLE_SHEET_ID=
# Tab + range if not default first sheet (must match your doc). Quote sheet names with spaces:
# WEED_ARTICLE_SHEET_RANGE='Weed.com Learn Articles'!A1:J5000
# Recommended: create a Google Cloud service account, enable Sheets API, paste the full JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Then share the spreadsheet with the service account email (Viewer is enough).
# Alternative for a publicly readable sheet only:
# GOOGLE_SHEETS_API_KEY=

# ── Gemini (shared across all sites) ───────
GEMINI_API_KEY=
# Image generation model. Default: gemini-2.5-flash-image (works on free AI Studio tier).
# If you set imagen-* without a paid plan, the app falls back to gemini-2.5-flash-image automatically.
# Imagen is only used end-to-end when your API key has Imagen billing enabled.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# ── Eden AI → Winston AI detection (all article generators) ──
# API key from https://app.edenai.run (Universal AI / text ai_detection)
# Playground model: text/ai_detection/winstonai
EDEN_AI_API_KEY=
# Optional override (default text/ai_detection/winstonai)
# EDEN_AI_DETECTION_MODEL=text/ai_detection/winstonai
# Pass when AI-risk score (100 - humanScore) is below this (default 30 ≈ humanScore >= 70)
# WINSTON_AI_RISK_THRESHOLD=30
# Flag sentences with Winston human score below this (default 50)
# WINSTON_AI_SENTENCE_HUMAN_FLOOR=50
# Max voice-pass retries when score is too high (default 2)
# WINSTON_AI_MAX_RETRIES=2
# After detectLoop still fails threshold, run a full humanization review + re-score (default true)
# WINSTON_AI_HUMANIZE_ON_FAIL=true

# WordPress author for strain page bylines (default slug: editorial-team)
# WEED_COM_EDITORIAL_AUTHOR_SLUG=editorial-team
# Or set numeric user ID directly if slug lookup fails:
# WEED_COM_EDITORIAL_AUTHOR_ID=

# ── Instagram / Meta ───────────────────────
INSTAGRAM_BUSINESS_ACCOUNT_ID=     # numeric ID e.g. 17841400000000000
FACEBOOK_PAGE_ACCESS_TOKEN=         # long-lived page token
FACEBOOK_APP_ID=                    # from Facebook Developer App
FACEBOOK_APP_SECRET=                # from Facebook Developer App
